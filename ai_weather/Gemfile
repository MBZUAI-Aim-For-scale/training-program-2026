source 'https://rubygems.org'

# Use modern Jekyll 4.x directly (no github-pages wrapper)
gem 'jekyll', '~> 4.3'
gem 'json', '2.7.1'
gem 'bigdecimal', '3.1.8'
gem 'google-protobuf', '3.25.5'

# Plugins (all natively supported by GitHub Pages)
group :jekyll_plugins do
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-seo-tag'
  gem 'jekyll-redirect-from'
end

# Required for Jekyll 4 on Ruby 3.0+
gem 'webrick'
