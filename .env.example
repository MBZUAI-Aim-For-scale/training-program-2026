# Host paths (where your data lives on macOS)
HOST_DATA_DIR=~/data
HOST_OUTPUT_DIR=~/data/ROMP_OUT

# Earthdata credentials (register free at urs.earthdata.nasa.gov)
EARTHDATA_USERNAME=your_username
EARTHDATA_PASSWORD=your_password

# Optional: Jupyter token (for dev profile)
JUPYTER_TOKEN=changeme

# The program's Google bucket (Demo 4 reads its forecasts and observations from it).
# Google credentials don't go in this file: on a Spark, docker/run.sh uses the machine's
# read-only key; elsewhere, run `gcloud auth application-default login`.
DEMO_BUCKET=""
